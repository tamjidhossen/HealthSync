    "testingInstructions": {
        "setup": [
            "1. Register doctor and patient accounts using the testUsers data",
            "2. Login as doctor to get doctorToken",
            "3. Login as patient to get patientToken",
            "4. Replace REPLACE_WITH_PATIENT_ID with actual patient MongoDB ObjectId"
        ],
        "testSequence": [
            "1. Create basic prescription using basicPrescription data",
            "2. Create emergency prescription using emergencyPrescription data",
            "3. Test patient viewing prescriptions (my-prescriptions endpoint)",
            "4. Test doctor viewing prescriptions (doctor-prescriptions endpoint)",
            "5. Add medicine using medicineAdditions data",
            "6. Add medical test using medicalTestAdditions data",
            "7. Update prescription using prescriptionUpdates data",
            "8. Get prescription statistics",
            "9. Cancel a prescription",
            "10. Test various search and filter queries"
        ],
        "notes": [
            "- All medicine names and dosages are realistic and commonly prescribed",
            "- Test data includes various medical conditions and urgency levels",
            "- ICD codes are real medical coding standards",
            "- Vital signs are within realistic ranges",
            "- Follow-up dates are set appropriately in the future"
